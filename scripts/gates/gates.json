{
  "$comment": "门禁清单：本文件是唯一来源。加一道门禁只改这里 —— 本地门禁（scripts/check.sh）、持续集成（.github/workflows/ci.yml）、门禁自检（scripts/verify-gates.sh）都经 scripts/gates/run.mjs 读它，不再各自写一遍命令或版本。",
  "gates": [
    {
      "id": "archcheck",
      "label": "archcheck 规则自检 + 棘轮（两遍）",
      "group": "backend",
      "canaries": [2, 3],
      "steps": [
        { "cwd": "backend", "command": ["go", "test", "./tools/archcheck/..."] },
        {
          "cwd": "backend",
          "command": [
            "go",
            "run",
            "./tools/archcheck",
            "--mode=error",
            "--max-violations=__ARCH_MAX_VIOLATIONS__",
            "."
          ]
        },
        {
          "cwd": "backend",
          "command": [
            "go",
            "run",
            "./tools/archcheck",
            "--mode=error",
            "--skip-tests=false",
            "--max-violations=__ARCH_MAX_VIOLATIONS__",
            "."
          ]
        }
      ]
    },
    {
      "id": "contract-freshness",
      "label": "契约未过期（#273 那一份判定，三处共用）",
      "group": "contract",
      "canaries": [5],
      "passthrough": true,
      "steps": [
        { "cwd": ".", "command": ["node", "scripts/check-contract-freshness.mjs"] }
      ]
    },
    {
      "id": "contract-freshness-cases",
      "label": "契约未过期判定的行为用例",
      "group": "contract",
      "canaries": [5],
      "steps": [
        { "cwd": ".", "command": ["node", "scripts/test-contract-freshness.mjs"] }
      ]
    },
    {
      "id": "token-parity",
      "label": "两端 tokens.css 同源",
      "group": "frontend",
      "canaries": [12],
      "steps": [
        { "cwd": ".", "command": ["node", "scripts/check-token-parity.mjs"] }
      ]
    },
    {
      "id": "image-shaping-parity",
      "label": "两端同源副本（定形工具 + 裁剪窗四份组件）",
      "group": "frontend",
      "canaries": [13],
      "steps": [
        { "cwd": ".", "command": ["node", "scripts/check-image-shaping-parity.mjs"] }
      ]
    }
  ],
  "canaries": [
    {
      "id": 1,
      "title": "后端单测",
      "affected": ["backend/**"]
    },
    {
      "id": 2,
      "title": "archcheck 棘轮",
      "affected": ["backend/**"]
    },
    {
      "id": 3,
      "title": "archcheck 规则自检",
      "affected": ["backend/tools/archcheck/**"]
    },
    {
      "id": 4,
      "title": "前端 typecheck",
      "affected": ["frontend/**"]
    },
    {
      "id": 5,
      "title": "契约未过期",
      "affected": [
        "backend/**",
        "Makefile",
        "scripts/check-contract-freshness.mjs",
        "scripts/test-contract-freshness.mjs",
        "scripts/contract-structures.json",
        "scripts/tool-versions.env"
      ]
    },
    {
      "id": 6,
      "title": "前端契约类型未过期",
      "affected": [
        "backend/docs/swagger.json",
        "frontend/app/types/openapi.d.ts",
        "frontend_admin/app/types/openapi.d.ts"
      ]
    },
    {
      "id": 7,
      "title": "契约 ↔ 路由对账",
      "affected": [
        "backend/docs/swagger.json",
        "backend/internal/platform/http/router/**"
      ]
    },
    {
      "id": 8,
      "title": "admin 鉴权",
      "affected": [
        "backend/internal/platform/http/router/**",
        "backend/internal/**/adapter/http/**"
      ]
    },
    {
      "id": 9,
      "title": "菜单 ↔ 页面",
      "affected": [
        "frontend_admin/app/utils/menu.ts",
        "frontend_admin/app/pages/**"
      ]
    },
    {
      "id": 10,
      "title": "前端 lint",
      "affected": ["frontend/**", "frontend_admin/**"]
    },
    {
      "id": 11,
      "title": "覆盖率门槛",
      "affected": [
        "frontend/vitest.config.ts",
        "frontend_admin/vitest.config.ts",
        "frontend/**",
        "frontend_admin/**"
      ]
    },
    {
      "id": 12,
      "title": "两端 tokens.css 同源",
      "affected": [
        "scripts/check-token-parity.mjs",
        "frontend/app/assets/css/tokens.css",
        "frontend_admin/app/assets/css/tokens.css"
      ]
    },
    {
      "id": 13,
      "title": "两端同源副本（定形工具 + 裁剪窗）",
      "affected": [
        "scripts/check-image-shaping-parity.mjs",
        "frontend/app/utils/imageShaping.ts",
        "frontend_admin/app/utils/imageShaping.ts",
        "frontend/app/components/media/**",
        "frontend_admin/app/components/media/**"
      ]
    },
    {
      "id": 14,
      "title": "生成式装饰参数校验",
      "affected": [
        "scripts/generate-deco-parameters.mjs",
        "config/deco-charm-parameters.json",
        "frontend/app/utils/decoParams.ts",
        "frontend_admin/app/utils/decoParams.ts"
      ]
    }
  ]
}
