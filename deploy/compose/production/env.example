# 生产环境变量模板（docker compose 读取同目录的 .env）
#
#   cp env.example .env && vi .env
#   docker compose up -d --build
#
# 与仓库根的 .envrc.example 唯一的实质差异：
#   本文件给**容器内**的进程用 —— BLOGX_APP_HOST 必须是 0.0.0.0
#   那份给**宿主机**上 go run 用 —— 监听 127.0.0.1
# 其余键名与取值口径一致；改这里时记得同步另一份。
#
# ⚠️ 上线前必须改的（其余可沿用示例值）：
#
#   BLOGX_APP_HOST=0.0.0.0           —— 容器内监听回环，nginx 连不上 → /api 全 502，
#                                       而 docker compose ps 全是 healthy（健康检查走容器内
#                                       回环，看不出问题）。这是最难查的一条。
#   BLOGX_NGINX_ENV=production       —— 模板默认 local（只监听 80、不加载证书）；
#                                       生产形态才会启用 443 并要求证书存在。
#   BLOGX_APP_ENV=production         —— 影响日志 env 列与 Cookie 行为。注意：本地用 http
#                                       跑时保持 dev，改成 production 后 Secure Cookie
#                                       在 http://localhost 上不会被写入，登录会失败。
#   BLOGX_GIN_MODE=release
#   BLOGX_JWT_SECRET                 —— 泄露等于任何人都能签发登录态
#   BLOGX_DB_PASSWORD / BLOGX_DB_REPL_PASSWORD
#   BLOGX_REDIS_PASSWORD / BLOGX_ES_PASSWORD / BLOGX_CLICKHOUSE_PASSWORD
#
# 不要提交 .env（已在 .gitignore 中）。

TZ='Asia/Shanghai'
BLOGX_SERVER_ID='1'
# 容器内必须监听全部网卡。写 127.0.0.1 时服务只在容器内部回环上存在，
# nginx 经 blogx_network 访问 blogx_server:8080 会连接被拒 → 502。
BLOGX_APP_HOST='0.0.0.0'
BLOGX_APP_PORT='8080'
BLOGX_APP_ENV='dev'
BLOGX_GIN_MODE='release'
BLOGX_LOG_APP='blogx_server'
BLOGX_LOG_LEVEL='info'
BLOGX_LOG_REQUEST_LOG_ENABLED='true'
BLOGX_LOG_QUERY_DEFAULT_LIMIT='20'
BLOGX_LOG_QUERY_MAX_LIMIT='200'
# 日志清理（settings.yaml 里的默认值是 true / 7 / 03:30:00，生产建议显式写出来：
# 默认值改了不会通知你，而"日志被悄悄提前删掉"这种事很难事后发现）
BLOGX_LOG_CLEANUP_ENABLED='true'
BLOGX_LOG_RETENTION_DAYS='7'
BLOGX_LOG_CLEANUP_RUN_AT='03:30:00'


# Nginx 固定配置选择（只此一个开关，其余变量由 render-config.sh 推导）：
# - 本地：BLOGX_NGINX_ENV='local'       只监听 80，不加载证书
# - API-only 联调：'api-only'            / 与 /admin/ 返回 404
# - 测试：'test'                         域名 blog.gentlybeing.cn
# - 生产：'production'                   域名 blogx.gentlybeing.cn
# 非 local 形态都要求先把证书放到 deploy/state/nginx/cert/domain.pem 与 domain.key
BLOGX_NGINX_ENV='local'

# Web SSR 部署参数
# 本地 compose：
BLOGX_WEB_ENV_PROFILE='local-local'
BLOGX_WEB_SITE_URL='http://localhost'
BLOGX_WEB_API_UPSTREAM='http://blogx_server:8080'
BLOGX_WEB_API_BASE='/api'
BLOGX_WEB_WS_PATH='/api/chat/ws'
BLOGX_WEB_ASSET_PROXY_BASE='/uploads'
#
# 测试构建口径：
# BLOGX_NGINX_ENV='test'
# BLOGX_WEB_ENV_PROFILE='test'
# BLOGX_WEB_SITE_URL='https://blog.gentlybeing.cn'
# BLOGX_WEB_API_UPSTREAM='http://blogx_server:8080'
#
# 生产构建口径：
# BLOGX_NGINX_ENV='production'
# BLOGX_WEB_ENV_PROFILE='production'
# BLOGX_WEB_SITE_URL='https://blogx.gentlybeing.cn'
# BLOGX_WEB_API_UPSTREAM='http://blogx_server:8080'

# Admin 后台（挂载在 /admin/，地址要带尾斜杠）
BLOGX_ADMIN_ENV_PROFILE='local-local'
BLOGX_ADMIN_SITE_URL='http://localhost/admin'
BLOGX_ADMIN_WEB_SITE_URL='http://localhost'
BLOGX_ADMIN_API_BASE='/api'
BLOGX_ADMIN_API_UPSTREAM='http://blogx_server:8080'

# 镜像 tag —— 回滚口的开关。
#
# 三个变量对应 compose 里的 ${BLOGX_SERVER_IMAGE:-...}，默认值与示例一致，
# 所以不改也能跑。它们的价值在于**回滚**：发布前把当前版本打上日期 tag 留档，
#     docker tag blogx-server:production blogx-server:2026-10-26
# 出事时把这里改成旧 tag，然后 `docker compose up -d`（**不要带 --build**，
# 带 --build 会重新构建，等于把回滚变成又一次发布）。
BLOGX_SERVER_IMAGE='blogx-server:production'
BLOGX_WEB_IMAGE='blogx-web:production'
BLOGX_ADMIN_IMAGE='blogx-admin:production'

# JWT
BLOGX_JWT_SECRET='******'
BLOGX_JWT_ISSUER='******'
BLOGX_JWT_EXPIRE_HOURS='24'
BLOGX_JWT_REFRESH_EXPIRE_HOURS='720'

# MySQL
BLOGX_DB_NAME='blogx'
BLOGX_DB_USER='admin'
BLOGX_DB_PASSWORD='******'
BLOGX_DB_REPL_USER='repl'
BLOGX_DB_REPL_PASSWORD='******'
BLOGX_DB_MASTER_HOST='127.0.0.1'
BLOGX_DB_MASTER_PORT='3306'
BLOGX_DB_REPLICA_HOST='127.0.0.1'
BLOGX_DB_REPLICA_PORT='3307'
BLOGX_GORM_DEBUG='true'
BLOGX_GORM_MAX_IDLE_CONNS='100'
BLOGX_GORM_MAX_OPEN_CONNS='100'
BLOGX_GORM_CONN_MAX_LIFETIME_HOURS='1'

# Redis
BLOGX_REDIS_HOST='127.0.0.1'
BLOGX_REDIS_PORT='6379'
# 必须留空：redis.conf 只配了 requirepass（没有 ACL 账号）。
# 这里填任何非空字符串，go-redis 都会走 ACL 认证 → WRONGPASS / invalid username-password pair。
BLOGX_REDIS_USERNAME=''
BLOGX_REDIS_PASSWORD='******'
BLOGX_REDIS_DB='0'

# Elasticsearch
BLOGX_ES_URL='http://127.0.0.1:9200'
BLOGX_ES_PORT='9200'
BLOGX_ES_ADDR='127.0.0.1:9200'
BLOGX_ES_INDEX='article_index'
BLOGX_ES_USERNAME='elastic'
BLOGX_ES_PASSWORD='******'
BLOGX_ES_USE_HTTPS='false'

# ClickHouse
BLOGX_CLICKHOUSE_ADDR='127.0.0.1:9000'
BLOGX_CLICKHOUSE_DB='blogx_logs'
BLOGX_CLICKHOUSE_USERNAME='default'
BLOGX_CLICKHOUSE_PASSWORD='******'
BLOGX_CLICKHOUSE_DIAL_TIMEOUT_SEC='5'
BLOGX_CLICKHOUSE_MAX_OPEN_CONNS='10'
BLOGX_CLICKHOUSE_MAX_IDLE_CONNS='5'
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT='1'

# MySQL -> ES 同步
BLOGX_RIVER_ENABLED='true'
BLOGX_RIVER_SERVER_ID='1001'
BLOGX_RIVER_MYSQL_ADDR='127.0.0.1:3306'
BLOGX_RIVER_MYSQL_USER='admin'
# 必须与 BLOGX_DB_PASSWORD 相同：river 用业务账号连主库读 binlog，
# 这里填错的表现是"服务正常、但搜索永远搜不到新文章"。
BLOGX_RIVER_MYSQL_PASSWORD='******'

# 图片引用关系同步
BLOGX_IMAGE_REF_RIVER_ENABLED='true'
BLOGX_IMAGE_REF_RIVER_SERVER_ID='1002'
BLOGX_IMAGE_REF_RIVER_SCHEMA='blogx'
BLOGX_IMAGE_REF_RIVER_MYSQL_ADDR='127.0.0.1:3306'
BLOGX_IMAGE_REF_RIVER_MYSQL_USER='admin'
# 同上：必须与 BLOGX_DB_PASSWORD 相同
BLOGX_IMAGE_REF_RIVER_MYSQL_PASSWORD='******'

# 上传
BLOGX_UPLOAD_SIZE_MB='3'
BLOGX_UPLOAD_DIR='images001'

# 邮件
BLOGX_SMTP_HOST='smtp.qq.com'
BLOGX_SMTP_PORT='587'
BLOGX_SMTP_USERNAME='your-email@example.com'
BLOGX_SMTP_AUTH_CODE='******'
BLOGX_SMTP_FROM_NAME='我的博客'
BLOGX_SMTP_SSL='false'
BLOGX_SMTP_TLS='false'

# QQ 登录
BLOGX_QQ_APP_ID='123456'
BLOGX_QQ_APP_KEY='******'
BLOGX_QQ_REDIRECT='https://example.com/api/user/qq/callback'
BLOGX_LOGIN_QQ_ENABLED='false'

# 七牛云 —— 图片上传的**唯一**落地方式。
# 不填或 BLOGX_QINIU_ENABLED='false' 时，上传接口直接返回「站点未启用图片上传」。
# 别指望"关掉七牛就存本地"：后端的 /uploads 只是 r.Static 静态路由，
# 代码里没有任何写入 ./uploads 的逻辑（upload_dir 字段是预留、未被读取）。
BLOGX_QINIU_ENABLED='false'
BLOGX_QINIU_ACCESS_KEY='******'
BLOGX_QINIU_SECRET_KEY='******'
BLOGX_QINIU_BUCKET='your-bucket'
BLOGX_QINIU_DOMAIN='https://cdn.example.com'
BLOGX_QINIU_REGION='z2'
BLOGX_QINIU_PREFIX='myblogx'
BLOGX_QINIU_MAX_SIZE_MB='5'
BLOGX_QINIU_TOKEN_EXPIRY_SEC='1800'
BLOGX_QINIU_CALLBACK_URL=''

# 运行时默认站点开关
BLOGX_SITE_MODE='1'
BLOGX_LOGIN_USERNAME_PASSWORD_ENABLED='true'
BLOGX_LOGIN_EMAIL_ENABLED='true'
BLOGX_LOGIN_CAPTCHA_ENABLED='false'
BLOGX_EMAIL_CODE_TIMEOUT_MIN='5'
BLOGX_LOGIN_FAIL_WINDOW_MIN='15'
BLOGX_LOGIN_FAIL_USER_MAX='5'
BLOGX_LOGIN_FAIL_IP_MAX='20'
BLOGX_EMAIL_SEND_WINDOW_SEC='60'
BLOGX_EMAIL_SEND_PER_EMAIL_MAX='1'
BLOGX_EMAIL_SEND_PER_IP_MAX='10'
BLOGX_ARTICLE_SKIP_EXAMINING='true'
BLOGX_COMMENT_SKIP_EXAMINING='true'

# AI
BLOGX_AI_ENABLED='true'
BLOGX_AI_SECRET='sk-example-your-ai-token'
BLOGX_AI_BASE_URL='https://api.openai.com/v1/chat/completions'
BLOGX_AI_CHAT_MODEL='gpt-4.1-mini'
BLOGX_AI_REASON_MODEL=''
BLOGX_AI_TIMEOUT_SEC=''
BLOGX_AI_MAX_INPUT_CHARS='100000'
BLOGX_AI_TEMPERATURE=''
BLOGX_AI_DAILY_QUOTA=''

# ─────────────────────────────────────────────────────────────────────────────
# 关于 MYSQL_ROOT_PASSWORD / ELASTIC_PASSWORD / CLICKHOUSE_DB 这类别名：
#
# 它们原先是这个文件里的几行，形如 `MYSQL_ROOT_PASSWORD="$BLOGX_DB_PASSWORD"`。
# 但 **.env 不做变量嵌套展开** —— compose 只对 compose 文件里的 ${...} 做插值，
# 不解析 .env 内部的值。于是那几行要么落成字面量字符串 "$BLOGX_DB_PASSWORD"，
# 要么被人改成 ${BLOGX_DB_PASSWORD} 之后依然不生效，只是看起来配上了。
#
# compose 文件本来就是直接读 BLOGX_*（见 MYSQL_ROOT_PASSWORD: ${BLOGX_DB_PASSWORD}），
# 这些别名从未被读取，已删除。若确实要用 `docker run --env-file .env` 起临时容器，
# 请在命令行显式传：docker run -e MYSQL_ROOT_PASSWORD="$BLOGX_DB_PASSWORD" ...
# ─────────────────────────────────────────────────────────────────────────────
