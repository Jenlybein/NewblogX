{
  "name": "admin",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/run-env.mjs production build",
    "dev": "node scripts/run-env.mjs local-local dev",
    "dev:local-local": "node scripts/run-env.mjs local-local dev",
    "dev:local-test": "node scripts/run-env.mjs local-test dev",
    "build:test": "node scripts/run-env.mjs test build",
    "build:production": "node scripts/run-env.mjs production build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxi typecheck",
    "openapi:types": "openapi-typescript ../backend/docs/swagger.json -o app/types/openapi.d.ts",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:components": "node ../scripts/check-components.mjs",
    "check:tokens": "node ../scripts/check-design-tokens.mjs frontend_admin",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@css-render/vue3-ssr": "^0.15.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/sora": "^5.2.8",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.3",
    "@tabler/icons-vue": "^3.41.1",
    "@vueuse/nuxt": "^14.2.1",
    "naive-ui": "^2.44.1",
    "nuxt": "^4.4.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.31",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.2.6"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.12.0"
  }
}
