[client]
port        = 3306
socket      = /var/run/mysqld/mysqld.sock

[mysqld_safe]
pid-file    = /var/run/mysqld/mysqld.pid
socket      = /var/run/mysqld/mysqld.sock
nice        = 0

[mysqld]
user        = mysql
pid-file    = /var/run/mysqld/mysqld.pid
socket      = /var/run/mysqld/mysqld.sock
port        = 3306
basedir     = /usr
datadir     = /var/lib/mysql
tmpdir      = /tmp
secure-file-priv=/var/lib/mysql-files

# 基本配置
# 认证插件：与主库保持一致，理由见 master/my.cnf
default-authentication-plugin = mysql_native_password
character-set-server = utf8mb4
collation-server=utf8mb4_unicode_ci
explicit_defaults_for_timestamp=true
lower_case_table_names=1
max_allowed_packet=128M

# 主从复制必要配置
log-bin = mysql-bin
server-id = 2

# 固定relay log名称，避免容器ID变化导致冲突
# 8.0.30 起 relay-log-index 已废弃（会打警告且不再生效），只保留 relay-log
relay-log = mysql-relay-bin

# 允许所有IP连接（生产环境改为具体IP）
bind-address=0.0.0.0

# 开启GTID模式（全局事务标识符，自动配置）
gtid_mode=ON
# 强制GTID一致性（必须，确保所有事务都有GTID）
enforce_gtid_consistency=ON
# （可选，级联复制必须开启）记录GTID到binlog
# 8.0 起 log_slave_updates 更名为 log_replica_updates（旧名仍接受但已废弃）
log_replica_updates=ON