[client]
port        = 3306
socket      = /var/run/mysqld/mysqld.sock

[mysqld_safe]
pid-file    = /var/run/mysqld/mysqld.pid
socket      = /var/run/mysqld/mysqld.sock
nice        = 0  # 进程优先级（0为默认，数值越小优先级越高）

[mysqld]
user        = mysql
pid-file    = /var/run/mysqld/mysqld.pid
socket      = /var/run/mysqld/mysqld.sock
port        = 3306
basedir     = /usr
datadir     = /var/lib/mysql
tmpdir      = /tmp
secure-file-priv=/var/lib/mysql-files

# 基本配置
# 认证插件：MySQL 8.0 默认 caching_sha2_password，而 Go 的 go-sql-driver 在
# 非 TLS 连接下需要 allowPublicKeyRetrieval 才能完成首次握手。这里显式钉回
# mysql_native_password，让"容器配置"与"应用不改代码"同时成立。
# 8.0.34+ 会对该选项打 deprecation 警告（不影响功能）；MySQL 8.4 已移除，
# 届时要么给连接串加 TLS，要么改成 caching_sha2_password + allowPublicKeyRetrieval。
default-authentication-plugin = mysql_native_password
character-set-server = utf8mb4
collation-server=utf8mb4_unicode_ci
explicit_defaults_for_timestamp=true
lower_case_table_names=1
max_allowed_packet=128M

# 主从复制必要配置
log-bin = mysql-bin
server-id = 1

# binlog 合理配置
binlog_format = ROW           # binlog格式为ROW
sync_binlog = 1               # 1 立刻刷盘(数据安全但性能差) 2 每秒刷盘
# 8.0 用秒数；5.7 的 expire_logs_days 已废弃（8.0 仍接受但会警告）
binlog_expire_logs_seconds = 604800  # binlog 保留 7 天
max_binlog_size = 1G          # 单个binlog文件最大1G
innodb_flush_log_at_trx_commit=1 # 事务提交立即刷盘

# 固定relay log名称，避免容器ID变化导致冲突
relay-log = mysql-relay-bin

# 允许所有IP连接（生产环境改为具体IP）
bind-address=0.0.0.0

# 开启GTID模式（全局事务标识符，自动配置）
gtid_mode=ON
# 强制GTID一致性（必须，确保所有事务都有GTID）
enforce_gtid_consistency=ON
# （可选，级联复制必须开启）记录GTID到binlog
# 8.0 起 log_slave_updates 更名为 log_replica_updates（旧名仍接受但已废弃）
log_replica_updates=ON