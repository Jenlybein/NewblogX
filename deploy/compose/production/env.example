# 生产环境变量模板（docker compose 读取同目录的 .env）
#
#   cp env.example .env && vi .env
#   docker compose up -d --build
#
# 与仓库根的 .envrc.example 内容一致（那份给 direnv/本地 go run 用，带 export 前缀），
# 这里去掉 export、补上生产环境的取值要求 —— 两份由同一次转换生成，不会漂移。
#
# ⚠️ 上线前必须改的（其余可沿用示例值）：
#
#   BLOGX_DB_PASSWORD / BLOGX_DB_REPL_USER / BLOGX_DB_REPL_PASSWORD
#   BLOGX_REDIS_PASSWORD / BLOGX_CLICKHOUSE_PASSWORD
#   BLOGX_JWT_SECRET                 —— 泄露等于任何人都能签发登录态
#   BLOGX_APP_ENV=production         —— 决定日志 env 列与部分开关默认值
#   BLOGX_GIN_MODE=release
#   BLOGX_APP_HOST=0.0.0.0           —— 容器内必须监听 0.0.0.0，否则 nginx 连不上
#   BLOGX_NGINX_ENV=production       —— 决定 nginx 是否要求域名与证书
#
# 不要提交 .env（已在 .gitignore 中）。

TZ='Asia/Shanghai'
BLOGX_SERVER_ID='1'
BLOGX_APP_HOST='127.0.0.1'
BLOGX_APP_PORT='8080'
BLOGX_APP_ENV='dev'
BLOGX_GIN_MODE='release'
BLOGX_LOG_APP='blogx_server'
BLOGX_LOG_LEVEL='info'
BLOGX_LOG_REQUEST_LOG_ENABLED='true'
BLOGX_LOG_QUERY_DEFAULT_LIMIT='20'
BLOGX_LOG_QUERY_MAX_LIMIT='200'
# 日志清理（settings.yaml 里的默认值是 true / 7 / 03:30:00，生产建议显式写出来：
# 默认值改了不会通知你，而"日志被悄悄提前删掉"这种事很难事后发现）
BLOGX_LOG_CLEANUP_ENABLED='true'
BLOGX_LOG_RETENTION_DAYS='7'
BLOGX_LOG_CLEANUP_RUN_AT='03:30:00'


# Nginx 固定配置选择：
# - 本地：BLOGX_NGINX_ENV='local'
# - API-only 联调：BLOGX_NGINX_ENV='api-only'
# - 测试：BLOGX_NGINX_ENV='test'
# - 生产：BLOGX_NGINX_ENV='production'
# API-only 联调时可使用：export BLOGX_NGINX_ENV='api-only'
BLOGX_NGINX_ENV='local'

# Web SSR 部署参数
# 本地 compose：
BLOGX_WEB_ENV_PROFILE='local-local'
BLOGX_WEB_SITE_URL='http://localhost'
BLOGX_WEB_API_UPSTREAM='http://blogx_server:8080'
#
# 测试构建口径：
# export BLOGX_NGINX_ENV='test'
# export BLOGX_WEB_ENV_PROFILE='test'
# export BLOGX_WEB_SITE_URL='https://blog.gentlybeing.cn'
# export BLOGX_WEB_API_UPSTREAM='http://blogx_server:8080'
#
# 生产构建口径：
# export BLOGX_NGINX_ENV='production'
# export BLOGX_WEB_ENV_PROFILE='production'
# export BLOGX_WEB_SITE_URL='https://blogx.gentlybeing.cn'
# export BLOGX_WEB_API_UPSTREAM='http://blogx_server:8080'

# JWT
BLOGX_JWT_SECRET='******'
BLOGX_JWT_ISSUER='******'
BLOGX_JWT_EXPIRE_HOURS='24'
BLOGX_JWT_REFRESH_EXPIRE_HOURS='720'

# MySQL
BLOGX_DB_NAME='blogx'
BLOGX_DB_USER='admin'
BLOGX_DB_PASSWORD='******'
BLOGX_DB_REPL_USER='repl'
BLOGX_DB_REPL_PASSWORD='******'
BLOGX_DB_MASTER_HOST='127.0.0.1'
BLOGX_DB_MASTER_PORT='3306'
BLOGX_DB_REPLICA_HOST='127.0.0.1'
BLOGX_DB_REPLICA_PORT='3307'
BLOGX_GORM_DEBUG='true'
BLOGX_GORM_MAX_IDLE_CONNS='100'
BLOGX_GORM_MAX_OPEN_CONNS='100'
BLOGX_GORM_CONN_MAX_LIFETIME_HOURS='1'

# 给 docker-compose / 初始化脚本复用的别名
MYSQL_ROOT_PASSWORD="$BLOGX_DB_PASSWORD"
MYSQL_DATABASE="$BLOGX_DB_NAME"

# Redis
BLOGX_REDIS_HOST='127.0.0.1'
BLOGX_REDIS_PORT='6379'
BLOGX_REDIS_USERNAME='******'
BLOGX_REDIS_PASSWORD='******'
BLOGX_REDIS_DB='0'

# Kafka
BLOGX_KAFKA_BROKERS='127.0.0.1:19092'
BLOGX_KAFKA_TOPIC='blogx-mysql'
BLOGX_KAFKA_GROUP_ID='logistics_group'
BLOGX_KAFKA_USERNAME='logistics'
BLOGX_KAFKA_PASSWORD='******'

# Elasticsearch
BLOGX_ES_URL='http://127.0.0.1:9200'
BLOGX_ES_PORT='9200'
BLOGX_ES_ADDR='127.0.0.1:9200'
BLOGX_ES_INDEX='article_index'
BLOGX_ES_USERNAME='elastic'
BLOGX_ES_PASSWORD='******'
BLOGX_ES_USE_HTTPS='false'

# 给 docker-compose 复用的别名
ELASTIC_PASSWORD="$BLOGX_ES_PASSWORD"

# ClickHouse
BLOGX_CLICKHOUSE_ADDR='127.0.0.1:9000'
BLOGX_CLICKHOUSE_DB='blogx_logs'
BLOGX_CLICKHOUSE_USERNAME='default'
BLOGX_CLICKHOUSE_PASSWORD='******'
BLOGX_CLICKHOUSE_DIAL_TIMEOUT_SEC='5'
BLOGX_CLICKHOUSE_MAX_OPEN_CONNS='10'
BLOGX_CLICKHOUSE_MAX_IDLE_CONNS='5'

# 给 docker-compose 复用的别名
CLICKHOUSE_DB="$BLOGX_CLICKHOUSE_DB"
CLICKHOUSE_PASSWORD="$BLOGX_CLICKHOUSE_PASSWORD"
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT='1'

# MySQL -> ES 同步
BLOGX_RIVER_ENABLED='true'
BLOGX_RIVER_SERVER_ID='1001'
BLOGX_RIVER_MYSQL_ADDR='127.0.0.1:3306'
BLOGX_RIVER_MYSQL_USER='admin'
BLOGX_RIVER_MYSQL_PASSWORD='******'
BLOGX_RIVER_INDEX='article_index'

# 图片引用关系同步
BLOGX_IMAGE_REF_RIVER_ENABLED='true'
BLOGX_IMAGE_REF_RIVER_SERVER_ID='1002'
BLOGX_IMAGE_REF_RIVER_SCHEMA='blogx'
BLOGX_IMAGE_REF_RIVER_MYSQL_ADDR='127.0.0.1:3306'
BLOGX_IMAGE_REF_RIVER_MYSQL_USER='admin'
BLOGX_IMAGE_REF_RIVER_MYSQL_PASSWORD='******'

# 上传
BLOGX_UPLOAD_SIZE_MB='3'
BLOGX_UPLOAD_DIR='images001'

# 邮件
BLOGX_SMTP_HOST='smtp.qq.com'
BLOGX_SMTP_PORT='587'
BLOGX_SMTP_USERNAME='your-email@example.com'
BLOGX_SMTP_AUTH_CODE='******'
BLOGX_SMTP_FROM_NAME='我的博客'
BLOGX_SMTP_SSL='false'
BLOGX_SMTP_TLS='false'

# QQ 登录
BLOGX_QQ_APP_ID='123456'
BLOGX_QQ_APP_KEY='******'
BLOGX_QQ_REDIRECT='https://example.com/api/user/qq/callback'
BLOGX_LOGIN_QQ_ENABLED='false'

# 七牛云
BLOGX_QINIU_ENABLED='true'
BLOGX_QINIU_ACCESS_KEY='******'
BLOGX_QINIU_SECRET_KEY='******'
BLOGX_QINIU_BUCKET='your-bucket'
BLOGX_QINIU_DOMAIN='https://cdn.example.com'
BLOGX_QINIU_REGION='z2'
BLOGX_QINIU_PREFIX='myblogx'
BLOGX_QINIU_MAX_SIZE_MB='5'
BLOGX_QINIU_TOKEN_EXPIRY_SEC='1800'
BLOGX_QINIU_CALLBACK_URL='https://api.example.com/api/images/qiniu/callback'

# 运行时默认站点开关
BLOGX_SITE_MODE='1'
BLOGX_LOGIN_USERNAME_PASSWORD_ENABLED='true'
BLOGX_LOGIN_EMAIL_ENABLED='true'
BLOGX_LOGIN_CAPTCHA_ENABLED='false'
BLOGX_EMAIL_CODE_TIMEOUT_MIN='5'
BLOGX_LOGIN_FAIL_WINDOW_MIN='15'
BLOGX_LOGIN_FAIL_USER_MAX='5'
BLOGX_LOGIN_FAIL_IP_MAX='20'
BLOGX_EMAIL_SEND_WINDOW_SEC='60'
BLOGX_EMAIL_SEND_PER_EMAIL_MAX='1'
BLOGX_EMAIL_SEND_PER_IP_MAX='10'
BLOGX_ARTICLE_SKIP_EXAMINING='true'
BLOGX_COMMENT_SKIP_EXAMINING='true'

# AI
BLOGX_AI_ENABLED='true'
BLOGX_AI_SECRET='sk-example-your-ai-token'
BLOGX_AI_BASE_URL='https://api.openai.com/v1/chat/completions'
BLOGX_AI_CHAT_MODEL='gpt-4.1-mini'
BLOGX_AI_REASON_MODEL=''
BLOGX_AI_TIMEOUT_SEC=''
BLOGX_AI_MAX_INPUT_CHARS='100000'
BLOGX_AI_TEMPERATURE=''
BLOGX_AI_DAILY_QUOTA=''
