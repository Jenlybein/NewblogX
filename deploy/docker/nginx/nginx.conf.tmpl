# blogx nginx 统一模板
#
# 由 envsubst 渲染成 /etc/nginx/nginx.conf，再启动 nginx。
# 只替换 BLOGX_NGINX_* 变量（见 compose 的 nginx.command），
# nginx 自身的 $host / $remote_addr / $http_upgrade 等不会被误替换。
#
# 四种部署形态对应的变量取值：
#   local       SERVER_NAME=localhost           LISTEN_443/SSL 空   SERVE_WEB=1 SERVE_ADMIN=1
#   test        SERVER_NAME=blog.gentlybeing.cn LISTEN_443/SSL 有   SERVE_WEB=1 SERVE_ADMIN=1
#   production  SERVER_NAME=blogx.gentlybeing.cn LISTEN_443/SSL 有  SERVE_WEB=1 SERVE_ADMIN=1
#   api-only    SERVER_NAME=blog.gentlybeing.cn LISTEN_443/SSL 有   SERVE_WEB=0 SERVE_ADMIN=0
#
# api-only 时 web/admin 的 upstream 指到 api 容器（未被 location 使用，只是为了让
# nginx 启动阶段能解析主机名）；/admin 与 / 通过 serve 开关直接返回 404。

user  root;
worker_processes  1;

events {
    worker_connections  1024;
}

http {
  gzip on;
  gzip_min_length  5k;
  gzip_buffers     4 16k;
  gzip_http_version 1.0;
  gzip_comp_level 7;
  gzip_types       text/plain application/javascript text/css application/xml text/javascript application/x-httpd-php image/jpeg image/gif image/png;
  gzip_vary on;

  include       mime.types;
  default_type  application/octet-stream;

  access_log  /var/log/nginx/access.log;
  error_log  /var/log/nginx/error.log;

  sendfile        on;
  keepalive_timeout  500;
  client_max_body_size 2000m;

  # ---- TLS 证书（local 渲染为空行）----
  ${BLOGX_NGINX_SSL_CERT}
  ${BLOGX_NGINX_SSL_KEY}

  upstream blogx_web_upstream {
    server ${BLOGX_NGINX_WEB_UPSTREAM};
  }

  upstream blogx_admin_upstream {
    server ${BLOGX_NGINX_ADMIN_UPSTREAM};
  }

  upstream blogx_api_upstream {
    server ${BLOGX_NGINX_API_UPSTREAM};
  }

  server {
     listen       80;
     ${BLOGX_NGINX_LISTEN_443}
     server_name  ${BLOGX_NGINX_SERVER_NAME};

     # 部署形态开关：1=启用，0=该子站不对外提供（返回 404）
     set $blogx_serve_web "${BLOGX_NGINX_SERVE_WEB}";
     set $blogx_serve_admin "${BLOGX_NGINX_SERVE_ADMIN}";

     location = /admin {
        if ($blogx_serve_admin = "0") { return 404; }
        return 301 /admin/;
     }

     location ^~ /admin/ {
        if ($blogx_serve_admin = "0") { return 404; }
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_pass http://blogx_admin_upstream;
     }

     location = /api/chat/ws {
       proxy_pass http://blogx_api_upstream/api/chat/ws;
       proxy_http_version 1.1;
       proxy_set_header Upgrade $http_upgrade;
       proxy_set_header Connection "upgrade";
       proxy_redirect off;
       proxy_set_header Host $host;
       proxy_set_header X-Real-IP $remote_addr;
       proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
       proxy_set_header X-Forwarded-Proto $scheme;
       proxy_set_header X-Forwarded-Host $host;
       proxy_read_timeout 3600s;
     }

     location ^~ /api/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_pass http://blogx_api_upstream/api/;
     }

     location ^~ /uploads/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_pass http://blogx_api_upstream/uploads/;
     }

     location / {
        if ($blogx_serve_web = "0") { return 404; }
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_pass http://blogx_web_upstream;
     }
  }
}
